<?xml version="1.0" encoding="utf-8"?>
<!-- AIOVY launch screen: the brand symbol on warm ivory, shown only while the
     Flutter engine starts (removed on the first Flutter frame). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/aiovy_ivory" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_symbol" />
    </item>
</layer-list>
